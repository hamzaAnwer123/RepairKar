# ==============================================================================
# RepairKar — Apache Web Server Configuration (.htaccess)
# Compatible with local Apache (XAMPP), InfinityFree, and cPanel hosting.
# ==============================================================================

# 1. Custom Error Pages
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# 2. Block direct web access to sensitive environment, config & database files
<FilesMatch "^\.env|\.git|\.lock|schema\.sql|debug_log\.txt|\.log$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Disable Directory Browsing
Options -Indexes

# 4. Default Charset & MIME types
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddType text/html .html
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType image/webp .webp
</IfModule>

# 5. URL Rewriting & HTTPS Forwarding Support (when mod_rewrite is enabled)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prevent direct access to includes folder
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^config/ - [F,L]
</IfModule>
